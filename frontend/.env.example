# Copy this file to `.env` and adjust as needed.

# Base URL the frontend uses for API calls. Defaults to the relative "/api"
# path, which is proxied to the Django backend by the Vite dev server. Set a
# full URL here only when the API is hosted elsewhere (e.g. an external URL).
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api requests. Defaults to the local Django
# dev server.
VITE_PROXY_TARGET=http://127.0.0.1:8000
