# Copy this file to `.env` and adjust as needed.
# All values are optional; sensible development defaults are used when absent.

# Django core
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_DB_NAME=db.sqlite3

# API
# The frontend talks to the backend through the Vite dev proxy by default
# (see frontend/.env.example). Set a full URL here only if you host the API
# separately and need to bypass the proxy.
VITE_API_BASE_URL=/api
